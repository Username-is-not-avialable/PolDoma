# КАД kad.arbitr.ru
KAD_BASE_URL=https://kad.arbitr.ru
KAD_COOKIE_FILE=data/kad_cookies.json
# headless-режим cookie-fetcher (false — видно окно браузера, удобно при капче)
KAD_COOKIE_HEADLESS=true

# Поиск новых дел
KAD_SEARCH_DATE_FROM=            # YYYY-MM-DD, пусто = сегодня
KAD_SEARCH_DATE_TO=              # YYYY-MM-DD, пусто = сегодня

# База данных PostgreSQL (локальный docker-compose)
DATABASE_URL=postgresql+asyncpg://poldoma_user:poldoma_pass@localhost:5434/poldoma
POSTGRES_USER=poldoma_user
POSTGRES_PASSWORD=poldoma_pass
POSTGRES_DB=poldoma

# Настройки SMTP для email-рассылки
# Пример для Яндекс: smtp.yandex.ru, порт 465, SMTP_USE_SSL=true
# Пример для Mail.ru: smtp.mail.ru, порт 465, SMTP_USE_SSL=true
# Пример для Mailpit (локальный тест): localhost, порт 1025, SMTP_USE_SSL=false
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_USER=                       # ваш логин/email
SMTP_PASSWORD=                   # пароль приложения (App Password)
SMTP_FROM_EMAIL=                 # email отправителя (обычно совпадает с SMTP_USER)
SMTP_FROM_NAME=ПолдОма           # отображаемое имя


